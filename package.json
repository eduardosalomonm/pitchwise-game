{
  "name": "the-invisible-game-full-back",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "node scripts/run-game-browser-tests.mjs",
    "test:d1": "node --experimental-strip-types scripts/test-visitor-d1.mjs",
    "test:http": "node --experimental-strip-types scripts/test-visitor-http.mjs",
    "test:cleanup": "node scripts/test-playtest-cleanup.mjs",
    "check": "tsc --noEmit && npm test",
    "format": "oxfmt",
    "art:prepare": "node scripts/prepare-action-art.mjs",
    "art:optimize": "node --experimental-strip-types scripts/optimize-images.mjs",
    "art:social": "node scripts/render-og.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/migrate-playtest-local.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "shadcn": "4.18.0",
    "sharp": "0.34.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "vinext": { "image-size": "2.0.3" },
    "fast-uri": "3.1.9",
    "source-map-js": "1.2.2"
  }
}
